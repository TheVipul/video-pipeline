# =============================================================================
# Video Pipeline - Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your actual values.
# The pipeline will run WITHOUT an LLM API key (graceful degradation),
# but you lose AI metadata enrichment and brand safety moderation.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM (OpenAI-compatible endpoint to MiniMax)
# -----------------------------------------------------------------------------
# These settings let the OpenAI Python SDK talk to MiniMax's gateway.
#
# Endpoint: use api.minimax.io (api.minimax.chat is the China-region host and
# returns 401 "invalid api key" for international keys).
#
# Model: MiniMax-Text-01 rejects response_format={"type":"json_object"} with
# HTTP 400, which this pipeline relies on for structured output. M2.7 supports
# it. M2.7 also emits <think> reasoning blocks - the JSON extractor strips
# those, so no extra configuration is needed.
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=your_minimax_api_key_here
LLM_MODEL=MiniMax-M2.7-highspeed
# LLM_MODEL=abab6.5s-chat
# LLM_MODEL=gpt-4o
# LLM_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# YouTube credentials (OPTIONAL - dramatically reduces bot detection)
# -----------------------------------------------------------------------------
# To get a cookies.txt file:
#   1. Install "Get cookies.txt LOCALLY" browser extension
#   2. Log into YouTube in your browser
#   3. Export cookies to cookies.txt
#   4. Place file in inputs/cookies.txt
# Alternatively set YT_COOKIES_FROM_BROWSER=chrome,firefox,edge
YT_COOKIES_FILE=inputs/cookies.txt
# YT_COOKIES_FROM_BROWSER=chrome

# -----------------------------------------------------------------------------
# Proxies (OPTIONAL - the pipeline works with 0 proxies)
# -----------------------------------------------------------------------------
# Format: protocol://user:pass@host:port, one per line
# Free tier example: Webshare provides 10 datacenter proxies
PROXY_FILE=inputs/proxies.txt
# Leave PROXY_FILE empty to use direct connection (rely on player_client rotation)

# -----------------------------------------------------------------------------
# Pipeline configuration
# -----------------------------------------------------------------------------
# --- Mode -------------------------------------------------------------------
# "general" | "brand"
#
# Watermarking and brand-relevance filtering only make sense when publishing
# on behalf of a specific brand. In general mode they are switched off
# together, because a watermark for a brand that does not exist - and videos
# held for review against a profile nobody configured - is just confusing.
#
# `setup_wizard.py` sets these for you. Passing --brand <name> on the command
# line (anything other than "generic") also switches brand mode on for that run.
PIPELINE_MODE=general
PIPELINE_ENABLE_WATERMARK=false
PIPELINE_ENABLE_RELEVANCE_GATE=false

# Default publish target: local | gdrive | s3 | youtube
PIPELINE_PUBLISHER=local

PIPELINE_BRAND=generic
PIPELINE_OUTPUT_DIR=outputs
PIPELINE_MAX_VIDEOS=5
PIPELINE_MAX_DURATION_SEC=600
PIPELINE_DRY_RUN=false

# -----------------------------------------------------------------------------
# Safety railguards
# -----------------------------------------------------------------------------
SAFETY_MAX_LLM_SPEND_USD=1.50
SAFETY_DISK_MIN_FREE_GB=2.0
SAFETY_MAX_CONSECUTIVE_FAILURES=3
SAFETY_CIRCUIT_BREAKER_COOLDOWN_SEC=60
SAFETY_DOWNLOAD_MIN_INTERVAL_SEC=2
SAFETY_DOWNLOAD_MAX_INTERVAL_SEC=8
SAFETY_PROXY_REQUESTS_PER_MINUTE=10
